<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Strictly used for 127.0.0.1 loopback TCP sockets to Android's local adbd Wireless Debugging
      daemon and mDNS discovery (_adb-tls-pairing._tcp / _adb-tls-connect._tcp).
      Prominent disclosure is presented in-app prior to any local ADB connection.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
