    <string name="tpl_18_desc">Reminds you every Sunday at 18:00 to back up your camera roll.</string>
    <string name="tpl_19_title">Silence unknown callers</string>
    <string name="tpl_19_desc">Silences incoming calls from numbers not in your contacts.</string>
